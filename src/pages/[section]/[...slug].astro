---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import RoutineList from '../../components/RoutineList.astro';
import { getModule, tecnicoPages } from '../../data/modules';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { section: entry.data.section, slug: entry.data.routeSlug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const { data } = entry;

const allDocs = await getCollection('docs');

// Badges do hero conforme o tipo de página
let badges: { label: string; value: string }[] = [];
if (data.pageType === 'routine') {
  badges = [
    { label: 'Módulo', value: data.moduleLabel ?? '—' },
    { label: 'Tipo de rotina', value: data.routineType ?? 'Cadastro' },
    { label: 'Permissão', value: data.permission ?? 'Não' },
    { label: 'Impacto', value: data.impact ?? 'Operacional' },
  ];
} else if (data.pageType === 'module-index') {
  const mod = data.module ? getModule(data.module) : undefined;
  badges = [
    { label: 'Módulo', value: data.moduleLabel ?? data.title },
    { label: 'Rotinas', value: String(mod?.routines.length ?? 0) },
  ];
} else if (data.pageType === 'tecnico') {
  const b: { label: string; value: string }[] = [];
  if (data.moduleLabel) b.push({ label: 'Área', value: data.moduleLabel });
  if (data.routineType) b.push({ label: 'Tipo', value: data.routineType });
  if (data.impact) b.push({ label: 'Impacto', value: data.impact });
  badges = b;
}

// Breadcrumb
type Crumb = { label: string; href?: string };
const breadcrumb: Crumb[] = [{ label: 'Manual', href: '/' }];

if (data.section === 'modulos') {
  breadcrumb.push({ label: 'Módulos', href: '/#modulos' });
  if (data.pageType === 'module-index') {
    breadcrumb.push({ label: data.title });
  } else if (data.module) {
    const mod = getModule(data.module);
    breadcrumb.push({ label: mod?.label ?? data.moduleLabel ?? data.module, href: `/modulos/${data.module}` });
    breadcrumb.push({ label: data.title });
  }
} else if (data.section === 'manual') {
  breadcrumb.push({ label: data.title });
} else if (data.section === 'tecnico') {
  breadcrumb.push({ label: 'Doc. Técnicas e Configurações' });
  const parts = data.routeSlug.split('/');
  if (parts.length > 1) {
    // Subpágina de um grupo (ex.: fluxos/romaneio): mostra o grupo pai.
    const group = tecnicoPages.find((g) => g.slug === parts[0]);
    breadcrumb.push({ label: group?.title ?? parts[0], href: `/tecnico/${parts[0]}` });
  }
  breadcrumb.push({ label: data.title });
}

// Lista de rotinas para páginas de índice de módulo
const moduleDef = data.pageType === 'module-index' && data.module ? getModule(data.module) : undefined;
const availableSlugs = moduleDef
  ? allDocs
      .filter((d) => d.data.section === 'modulos' && d.data.pageType === 'routine' && d.data.module === moduleDef.id)
      .map((d) => d.data.routeSlug.split('/').slice(1).join('/'))
  : [];
---

<DocsLayout
  title={data.title}
  description={data.description}
  eyebrow={data.pageType === 'routine' ? data.moduleLabel : undefined}
  badges={badges}
  breadcrumb={breadcrumb}
  headings={headings}
>
  <Content />

  {moduleDef && (
    <>
      <h2 id="rotinas-do-modulo">Rotinas do módulo</h2>
      <RoutineList routines={moduleDef.routines} basePath={`/modulos/${moduleDef.id}`} availableSlugs={availableSlugs} />
    </>
  )}
</DocsLayout>
