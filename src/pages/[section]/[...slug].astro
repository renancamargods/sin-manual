---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import RoutineList from '../../components/RoutineList.astro';
import AskOrTicket from '../../components/AskOrTicket.astro';
import { getModule, tecnicoPages, manualPages, sortedModules, sortedRoutines, sortedTecnicoPages, sortedTecnicoSubPages } from '../../data/modules';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => data.lang !== 'en');
  return entries.map((entry) => ({
    params: { section: entry.data.section, slug: entry.data.routeSlug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const { data } = entry;

const allDocs = await getCollection('docs', ({ data }) => data.lang !== 'en');

// Badges do hero conforme o tipo de página
let badges: { label: string; value: string }[] = [];
if (data.pageType === 'routine') {
  badges = [
    { label: 'Módulo', value: data.moduleLabel ?? '—' },
    { label: 'Tipo de rotina', value: data.routineType ?? 'Cadastro' },
    { label: 'Permissão', value: data.permission ?? 'Não' },
    { label: 'Impacto', value: data.impact ?? 'Operacional' },
  ];
} else if (data.pageType === 'module-index') {
  const mod = data.module ? getModule(data.module) : undefined;
  badges = [
    { label: 'Módulo', value: data.moduleLabel ?? data.title },
    { label: 'Rotinas', value: String(mod?.routines.length ?? 0) },
  ];
} else if (data.pageType === 'tecnico') {
  const b: { label: string; value: string }[] = [];
  if (data.moduleLabel) b.push({ label: 'Área', value: data.moduleLabel });
  if (data.routineType) b.push({ label: 'Tipo', value: data.routineType });
  if (data.impact) b.push({ label: 'Impacto', value: data.impact });
  badges = b;
}

// Breadcrumb
type Crumb = { label: string; href?: string };
const breadcrumb: Crumb[] = [{ label: 'Manual', href: '/' }];

if (data.section === 'modulos') {
  breadcrumb.push({ label: 'Módulos', href: '/#modulos' });
  if (data.pageType === 'module-index') {
    breadcrumb.push({ label: data.title });
  } else if (data.module) {
    const mod = getModule(data.module);
    breadcrumb.push({ label: mod?.label ?? data.moduleLabel ?? data.module, href: `/modulos/${data.module}` });
    breadcrumb.push({ label: data.title });
  }
} else if (data.section === 'manual') {
  breadcrumb.push({ label: data.title });
} else if (data.section === 'tecnico') {
  breadcrumb.push({ label: 'Doc. Técnicas e Configurações' });
  const parts = data.routeSlug.split('/');
  if (parts.length > 1) {
    // Subpágina de um grupo (ex.: fluxos/romaneio): mostra o grupo pai.
    const group = tecnicoPages.find((g) => g.slug === parts[0]);
    breadcrumb.push({ label: group?.title ?? parts[0], href: `/tecnico/${parts[0]}` });
  }
  breadcrumb.push({ label: data.title });
}

// Lista de rotinas para páginas de índice de módulo
const moduleDef = data.pageType === 'module-index' && data.module ? getModule(data.module) : undefined;
const availableSlugs = moduleDef
  ? allDocs
      .filter((d) => d.data.section === 'modulos' && d.data.pageType === 'routine' && d.data.module === moduleDef.id)
      .map((d) => d.data.routeSlug.split('/').slice(1).join('/'))
  : [];

// --- Navegação Anterior / Próximo (somente páginas já publicadas) ---
const availModule: Record<string, string[]> = {};
const availManual: string[] = [];
const availTecnico: string[] = [];
for (const d of allDocs) {
  if (d.data.section === 'modulos' && d.data.pageType === 'routine' && d.data.module) {
    (availModule[d.data.module] ??= []).push(d.data.routeSlug.split('/').slice(1).join('/'));
  }
  if (d.data.section === 'manual') availManual.push(d.data.routeSlug);
  if (d.data.section === 'tecnico') availTecnico.push(d.data.routeSlug);
}
const moduleIndexAvailable = (id: string) =>
  allDocs.some((d) => d.data.section === 'modulos' && d.data.pageType === 'module-index' && d.data.module === id);

const flatPages: { href: string; title: string }[] = [];
for (const p of manualPages) {
  if (availManual.includes(p.slug)) flatPages.push({ href: `/manual/${p.slug}`, title: p.title });
}
for (const mod of sortedModules(false)) {
  if (moduleIndexAvailable(mod.id)) flatPages.push({ href: `/modulos/${mod.id}`, title: mod.label });
  for (const r of sortedRoutines(mod, false)) {
    if ((availModule[mod.id] ?? []).includes(r.slug)) {
      flatPages.push({ href: `/modulos/${mod.id}/${r.slug}`, title: r.title });
    }
  }
}
for (const g of sortedTecnicoPages(false)) {
  if (availTecnico.includes(g.slug)) flatPages.push({ href: `/tecnico/${g.slug}`, title: g.title });
  for (const sub of sortedTecnicoSubPages(g, false)) {
    if (availTecnico.includes(`${g.slug}/${sub.slug}`)) {
      flatPages.push({ href: `/tecnico/${g.slug}/${sub.slug}`, title: sub.title });
    }
  }
}
const currentHref = `/${data.section}/${data.routeSlug}`;
const currentIdx = flatPages.findIndex((f) => f.href === currentHref);
const prevPage = currentIdx > 0 ? flatPages[currentIdx - 1] : null;
const nextPage = currentIdx >= 0 && currentIdx < flatPages.length - 1 ? flatPages[currentIdx + 1] : null;
const backToModule =
  data.section === 'modulos' && data.pageType === 'routine' && data.module
    ? { href: `/modulos/${data.module}`, label: getModule(data.module)?.label ?? data.moduleLabel ?? 'módulo' }
    : null;
---

<DocsLayout
  title={data.title}
  description={data.description}
  eyebrow={data.pageType === 'routine' ? data.moduleLabel : undefined}
  badges={badges}
  breadcrumb={breadcrumb}
  headings={headings}
>
  <Content />

  {moduleDef && (
    <>
      <h2 id="rotinas-do-modulo">Rotinas do módulo</h2>
      <RoutineList routines={moduleDef.routines} basePath={`/modulos/${moduleDef.id}`} availableSlugs={availableSlugs} />
    </>
  )}

  {backToModule && (
    <p class="not-prose mt-10">
      <a href={backToModule.href} class="text-sm font-medium text-brand-red hover:underline">
        ← Voltar para {backToModule.label}
      </a>
    </p>
  )}

  <AskOrTicket />

  {(prevPage || nextPage) && (
    <nav class="not-prose mt-8 grid gap-3 border-t border-gray-200 pt-6 sm:grid-cols-2" aria-label="Navegação entre páginas">
      {prevPage ? (
        <a
          href={prevPage.href}
          class="group flex flex-col rounded-xl2 border border-gray-200 bg-white px-4 py-3 shadow-card transition hover:border-brand-red/30 hover:shadow-card-hover"
        >
          <span class="text-xs text-gray-500">← Anterior</span>
          <span class="mt-0.5 text-sm font-semibold text-gray-900 group-hover:text-brand-red">{prevPage.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block"></span>
      )}
      {nextPage && (
        <a
          href={nextPage.href}
          class="group flex flex-col rounded-xl2 border border-gray-200 bg-white px-4 py-3 text-right shadow-card transition hover:border-brand-red/30 hover:shadow-card-hover sm:col-start-2"
        >
          <span class="text-xs text-gray-500">Próximo →</span>
          <span class="mt-0.5 text-sm font-semibold text-gray-900 group-hover:text-brand-red">{nextPage.title}</span>
        </a>
      )}
    </nav>
  )}
</DocsLayout>
