---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroVideo from '../components/HeroVideo.astro';
import SearchBox from '../components/SearchBox.astro';
import ModuleCard from '../components/ModuleCard.astro';
import Icon from '../components/Icon.astro';
import { manualPages, modules, tecnicoPages } from '../data/modules';

// Vídeo de apresentação do hero.
// Cole aqui a URL (ou o ID) do vídeo no YouTube/Vimeo. Deixe vazio para
// mostrar o espaço "Vídeo em breve".
const heroVideo = {
  provider: 'youtube' as const, // 'youtube' ou 'vimeo'
  video: 'https://www.youtube.com/watch?v=YxgQm0ALeqE',
  title: 'Conheça o sistema em poucos minutos',
};

const shortcuts = [
  { title: 'Como acessar o sistema', href: '/manual/como-acessar', icon: 'lock' as const },
  { title: 'Visão geral do sistema', href: '/manual/visao-geral', icon: 'book' as const },
  { title: 'Perguntas frequentes', href: '/manual/faq', icon: 'info' as const },
  { title: 'Doc. Técnicas e Configurações', href: '/tecnico/fluxos', icon: 'shield' as const },
];
---

<BaseLayout title="Manual do Usuário" description="Manual do usuário do S.I.N Implant System: módulos, telas, rotinas e dúvidas frequentes.">
  <Hero
    eyebrow="S.I.N Implant System"
    title="Manual do Usuário Web"
    description="Encontre rapidamente como usar cada tela e rotina do sistema: cadastros, pedidos, faturamento, qualidade, regulatório e muito mais."
  >
    <div class="mt-8 max-w-xl">
      <SearchBox size="lg" placeholder="Buscar módulo, tela ou dúvida frequente..." />
    </div>

    <div class="mt-6 flex flex-wrap gap-2">
      {shortcuts.map((s) => (
        <a
          href={s.href}
          class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-white/80 transition hover:border-white/30 hover:bg-white/10 hover:text-white"
        >
          <Icon name={s.icon} class="h-3.5 w-3.5" />
          {s.title}
        </a>
      ))}
    </div>

    <div slot="media">
      <HeroVideo provider={heroVideo.provider} video={heroVideo.video} title={heroVideo.title} />
    </div>
  </Hero>

  <section id="modulos" class="w-full px-4 py-14 sm:px-6 lg:px-8 xl:px-10 scroll-mt-20">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">Módulos do sistema</h2>
        <p class="mt-1 text-sm text-gray-500">Escolha um módulo para ver suas telas e rotinas.</p>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {modules.map((mod) => (
        <ModuleCard label={mod.label} description={mod.description} href={`/modulos/${mod.id}`} count={mod.routines.length} />
      ))}
    </div>
  </section>

  <section class="border-t border-gray-200 bg-white">
    <div class="w-full px-4 py-14 sm:px-6 lg:px-8 xl:px-10">
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="mb-4 text-lg font-bold text-gray-900">Manual do Sistema SIN</h2>
          <ul class="space-y-2">
            {manualPages.map((p) => (
              <li>
                <a href={`/manual/${p.slug}`} class="group flex items-center justify-between rounded-lg border border-gray-200 px-4 py-3 text-sm transition hover:border-brand-red/30 hover:shadow-card">
                  <span>
                    <span class="block font-medium text-gray-900 group-hover:text-brand-red">{p.title}</span>
                    <span class="block text-xs text-gray-500">{p.description}</span>
                  </span>
                  <Icon name="arrow-right" class="h-4 w-4 flex-shrink-0 text-gray-300 group-hover:text-brand-red" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="mb-4 text-lg font-bold text-gray-900">Doc. Técnicas e Configurações</h2>
          <ul class="space-y-2">
            {tecnicoPages.map((p) => (
              <li>
                <a href={`/tecnico/${p.slug}`} class="group flex items-center justify-between rounded-lg border border-gray-200 px-4 py-3 text-sm transition hover:border-brand-red/30 hover:shadow-card">
                  <span>
                    <span class="block font-medium text-gray-900 group-hover:text-brand-red">{p.title}</span>
                    <span class="block text-xs text-gray-500">{p.description}</span>
                  </span>
                  <Icon name="arrow-right" class="h-4 w-4 flex-shrink-0 text-gray-300 group-hover:text-brand-red" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
