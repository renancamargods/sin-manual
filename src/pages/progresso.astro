---
import BaseLayout from '../layouts/BaseLayout.astro';
import { modules } from '../data/modules';

// --- Telas concluídas: lê o conteúdo bruto das páginas de tela (PT) no build ---
const rawFiles = import.meta.glob('../content/docs/modulos/**/*.mdx', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

type Done = { moduleId: string; slug: string; title: string; date: string };
const done: Done[] = [];
for (const [path, raw] of Object.entries(rawFiles)) {
  const parts = path.split('/');
  const file = parts[parts.length - 1];
  if (file === 'index.mdx') continue;
  const moduleId = parts[parts.length - 2];
  const slug = file.replace('.mdx', '');
  const titleM = raw.match(/^title:\s*(.+)$/m);
  const title = titleM ? titleM[1].trim() : slug;
  const dateM =
    raw.match(/version:\s*'1\.0',\s*date:\s*'([^']+)'/) ||
    raw.match(/Elaborado por',\s*name:\s*'[^']*',\s*date:\s*'([^']+)'/);
  const date = dateM ? dateM[1] : 'sem data';
  done.push({ moduleId, slug, title, date });
}

// --- Telas planejadas por módulo + % concluído ---
const perModule = modules
  .map((m) => {
    const planned = m.routines?.length ?? 0;
    const d = done.filter((x) => x.moduleId === m.id).length;
    return { id: m.id, label: m.label, planned, done: d, remaining: planned - d, pct: planned ? Math.round((d / planned) * 100) : 0 };
  })
  .filter((m) => m.planned > 0)
  .sort((a, b) => b.pct - a.pct || b.planned - a.planned);

const totalPlanned = perModule.reduce((a, x) => a + x.planned, 0);
const totalDone = done.length;
const totalRemaining = totalPlanned - totalDone;
const pct = totalPlanned ? Math.round((totalDone / totalPlanned) * 1000) / 10 : 0;
const modulosCompletos = perModule.filter((m) => m.remaining === 0);

// --- Últimas telas concluídas ---
const dkey = (s: string) => {
  const m = s.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  return m ? Number(m[3] + m[2] + m[1]) : -1;
};
const ultimas = [...done].sort((a, b) => dkey(b.date) - dkey(a.date)).slice(0, 8);
const moduloLabel = (id: string) => modules.find((m) => m.id === id)?.label ?? id;

const pctTxt = String(pct).replace('.', ',');
const buildDate = new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });

// Dados para o gráfico interativo (cliente)
const chartData = {
  total: { label: 'Geral — todos os módulos', done: totalDone, planned: totalPlanned, remaining: totalRemaining, pct },
  mods: perModule.map((m) => ({ label: m.label, done: m.done, planned: m.planned, remaining: m.remaining, pct: m.pct })),
};

const kpis = [
  { n: String(totalPlanned), label: 'Escopo total de telas', color: 'text-gray-900' },
  { n: String(totalDone), label: 'Concluídas', color: 'text-emerald-600' },
  { n: String(totalRemaining), label: 'Restantes', color: 'text-amber-600' },
  { n: `${pctTxt}%`, label: 'Concluído', color: 'text-brand-red' },
];
---

<BaseLayout
  title="Progresso do Manual"
  description="Acompanhamento em tempo real da construção do manual do S.I.N Implant System: telas concluídas, escopo restante e progresso por módulo."
>
  <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
    <!-- Cabeçalho -->
    <header class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Relatório de progresso</p>
      <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">Evolução do Manual do Usuário</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-gray-600">
        Acompanhamento da construção do manual do S.I.N Implant System — telas documentadas, escopo restante e progresso por módulo.
      </p>
      <p class="mt-3 text-sm text-gray-400">Atualizado automaticamente a cada publicação · última atualização em {buildDate}</p>
    </header>

    <!-- KPIs -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {kpis.map((k) => (
        <div class="rounded-xl2 border border-gray-100 bg-white p-5 text-center shadow-card">
          <div class={`text-4xl font-bold tabular-nums ${k.color}`}>{k.n}</div>
          <div class="mt-2 text-sm text-gray-500">{k.label}</div>
        </div>
      ))}
    </div>

    <!-- Conclusão por módulo (interativo) -->
    <section class="mt-8 rounded-xl2 border border-gray-100 bg-white p-6 shadow-card sm:p-8">
      <h2 class="mb-1 text-lg font-semibold text-gray-900">Conclusão por módulo</h2>
      <p class="mb-6 text-sm text-gray-500">Selecione um módulo na lista para ver o detalhe de concluídas e a fazer.</p>

      <div class="grid gap-6 md:grid-cols-5">
        <!-- Lista de módulos -->
        <div class="md:col-span-2">
          <div class="max-h-[430px] space-y-1 overflow-y-auto pr-1">
            <button type="button" class="mod-item" data-i="-1" aria-selected="true">
              <span class="mod-name font-semibold">Geral — todos os módulos</span>
              <span class="mod-meta">{totalDone}/{totalPlanned} · {pctTxt}%</span>
            </button>
            {perModule.map((m, i) => (
              <button type="button" class="mod-item" data-i={i} aria-selected="false">
                <span class="mod-name">
                  {m.label}
                  {m.remaining === 0 && <span class="ml-1 font-bold text-emerald-600">✓</span>}
                </span>
                <span class="mod-meta">{m.done}/{m.planned} · {m.pct}%</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Detalhe (donut + números) -->
        <div class="md:col-span-3">
          <div id="mod-detail" class="flex min-h-[300px] items-center justify-center rounded-xl border border-gray-100 bg-gray-50 p-6"></div>
        </div>
      </div>

      {modulosCompletos.length > 0 && (
        <p class="mt-6 text-sm text-gray-500">Módulos 100% concluídos: <strong class="text-gray-700">{modulosCompletos.map((m) => m.label).join(', ')}</strong>.</p>
      )}
    </section>

    <!-- Últimas telas concluídas -->
    <section class="mt-8 rounded-xl2 border border-gray-100 bg-white p-6 shadow-card sm:p-8">
      <h2 class="mb-4 text-lg font-semibold text-gray-900">Últimas telas concluídas</h2>
      <ul class="divide-y divide-gray-100">
        {ultimas.map((t) => (
          <li class="flex items-center justify-between gap-4 py-3">
            <span class="text-sm text-gray-800">
              {t.title}
              <span class="ml-1.5 text-xs uppercase tracking-wide text-gray-400">· {moduloLabel(t.moduleId)}</span>
            </span>
            <span class="shrink-0 text-sm tabular-nums text-gray-500">{t.date}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Metodologia -->
    <div class="mt-8 rounded-xl2 border border-gray-100 bg-gray-50 p-6 text-sm text-gray-500">
      <p class="mb-2 font-semibold text-gray-700">Como os números são apurados</p>
      <ul class="list-disc space-y-1 pl-5">
        <li><strong>Escopo total:</strong> todas as telas mapeadas nos módulos do sistema.</li>
        <li><strong>Concluídas:</strong> telas com página publicada, cada uma entregue em português e inglês.</li>
        <li>Esta página recalcula os números automaticamente a cada publicação do manual.</li>
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  .mod-item {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.6rem;
    padding: 0.6rem 0.8rem;
    text-align: left;
    font-size: 0.875rem;
    color: #374151;
    transition: background-color 0.15s ease;
  }
  .mod-item:hover {
    background-color: #f3f4f6;
  }
  .mod-item .mod-meta {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  .mod-item[aria-selected='true'] {
    background-color: rgba(204, 9, 59, 0.07);
    box-shadow: inset 3px 0 0 #cc093b;
    color: #cc093b;
  }
  .mod-item[aria-selected='true'] .mod-meta {
    color: #cc093b;
  }
</style>

<script is:inline define:vars={{ chartData }}>
  (function () {
    var detail = document.getElementById('mod-detail');
    var items = document.querySelectorAll('.mod-item');

    function render(item) {
      var r = 54;
      var c = 2 * Math.PI * r;
      var pct = Math.max(0, Math.min(100, item.pct));
      var dash = (pct / 100) * c;
      var arc = pct >= 100 ? '#1f9d63' : 'url(#donutGrad)';
      var pctLabel = String(item.pct).replace('.', ',');
      detail.innerHTML =
        '<div class="w-full text-center">' +
          '<div class="mb-4 text-sm font-semibold uppercase tracking-wide text-gray-500">' + item.label + '</div>' +
          '<svg viewBox="0 0 140 140" width="176" height="176" class="mx-auto">' +
            '<defs><linearGradient id="donutGrad" x1="0" y1="0" x2="1" y2="1">' +
              '<stop offset="0%" stop-color="#CC093B"/><stop offset="100%" stop-color="#F18800"/>' +
            '</linearGradient></defs>' +
            '<circle cx="70" cy="70" r="54" fill="none" stroke="#e9edf1" stroke-width="15"/>' +
            '<circle cx="70" cy="70" r="54" fill="none" stroke="' + arc + '" stroke-width="15" stroke-linecap="round" ' +
              'stroke-dasharray="' + dash + ' ' + c + '" transform="rotate(-90 70 70)"/>' +
            '<text x="70" y="67" text-anchor="middle" font-size="28" font-weight="700" fill="#1a1417">' + pctLabel + '%</text>' +
            '<text x="70" y="90" text-anchor="middle" font-size="12" fill="#6b7280">concluído</text>' +
          '</svg>' +
          '<div class="mt-6 flex justify-center gap-8">' +
            '<div><div class="text-2xl font-bold tabular-nums text-emerald-600">' + item.done + '</div><div class="text-xs text-gray-500">concluídas</div></div>' +
            '<div><div class="text-2xl font-bold tabular-nums text-amber-600">' + item.remaining + '</div><div class="text-xs text-gray-500">a fazer</div></div>' +
            '<div><div class="text-2xl font-bold tabular-nums text-gray-800">' + item.planned + '</div><div class="text-xs text-gray-500">total</div></div>' +
          '</div>' +
        '</div>';
    }

    items.forEach(function (btn) {
      btn.addEventListener('click', function () {
        items.forEach(function (b) { b.setAttribute('aria-selected', 'false'); });
        btn.setAttribute('aria-selected', 'true');
        var i = parseInt(btn.getAttribute('data-i'), 10);
        render(i === -1 ? chartData.total : chartData.mods[i]);
      });
    });

    render(chartData.total);
  })();
</script>
