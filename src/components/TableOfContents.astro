---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 0 && (
  <nav class="sticky top-24 hidden max-h-[calc(100vh-7rem)] w-56 flex-shrink-0 overflow-y-auto xl:block" aria-label="Nesta página">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-brand-muted">Nesta página</p>
    <ul class="space-y-2 border-l border-brand-line text-sm">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class="block border-l-2 border-transparent py-0.5 pl-3 -ml-px text-brand-muted transition hover:border-brand-red hover:text-brand-red-on-dark"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
