---
import Icon from './Icon.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="not-prose my-5 divide-y divide-brand-line rounded-xl2 border border-brand-line bg-brand-surface shadow-card">
  {items.map((item) => (
    <details class="group px-5 py-4 open:pb-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-brand-fg marker:content-none">
        {item.question}
        <Icon
          name="chevron-down"
          class="h-4 w-4 flex-shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180 group-open:text-brand-red-on-dark"
        />
      </summary>
      <p class="mt-3 text-sm leading-6 text-brand-fg-2">{item.answer}</p>
    </details>
  ))}
</div>
