---
// Controle do documento: responsáveis (elaborou / revisou / aprovou) e
// histórico de versões. Usado em páginas de fluxo/processo para padronizar
// o rodapé de controle, no estilo de documentos de qualidade.
interface Signer {
  role: string; // ex.: "Elaborado por", "Revisado por", "Aprovado por"
  name: string;
  date?: string;
}
interface Version {
  version: string;
  date: string;
  author: string;
  description: string;
}
interface Props {
  signers?: Signer[];
  versions?: Version[];
}

const { signers = [], versions = [] } = Astro.props;
---

<div class="not-prose my-6 space-y-5">
  {signers.length > 0 && (
    <div class="grid gap-4 sm:grid-cols-3">
      {signers.map((s) => (
        <div class="rounded-xl2 border border-gray-200 bg-white p-4 shadow-card">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{s.role}</p>
          <p class="mt-1.5 text-sm font-semibold text-gray-900">{s.name}</p>
          {s.date && <p class="mt-0.5 text-xs text-gray-500">Data: {s.date}</p>}
        </div>
      ))}
    </div>
  )}

  {versions.length > 0 && (
    <div class="overflow-x-auto rounded-xl2 border border-gray-200 shadow-card">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <thead>
          <tr class="bg-gray-50">
            <th class="border-b border-gray-200 px-4 py-3 font-semibold text-gray-700">Versão</th>
            <th class="border-b border-gray-200 px-4 py-3 font-semibold text-gray-700">Data</th>
            <th class="border-b border-gray-200 px-4 py-3 font-semibold text-gray-700">Autor</th>
            <th class="border-b border-gray-200 px-4 py-3 font-semibold text-gray-700">Descrição da alteração</th>
          </tr>
        </thead>
        <tbody>
          {versions.map((v) => (
            <tr class="border-b border-gray-100 last:border-0 even:bg-gray-50/40 hover:bg-brand-orange/5">
              <td class="whitespace-nowrap px-4 py-3 align-top font-medium text-gray-900">{v.version}</td>
              <td class="whitespace-nowrap px-4 py-3 align-top text-gray-700">{v.date}</td>
              <td class="px-4 py-3 align-top text-gray-700">{v.author}</td>
              <td class="px-4 py-3 align-top text-gray-700">{v.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>
