---
// Controle do documento: responsáveis (elaborou / revisou / aprovou) e
// histórico de versões. Usado em páginas de fluxo/processo para padronizar
// o rodapé de controle, no estilo de documentos de qualidade.
interface Signer {
  role: string; // ex.: "Elaborado por", "Revisado por", "Aprovado por"
  name: string;
  date?: string;
}
interface Version {
  version: string;
  date: string;
  author: string;
  description: string;
}
interface Props {
  signers?: Signer[];
  versions?: Version[];
}

const { signers = [], versions = [] } = Astro.props;
---

<div class="not-prose my-6 space-y-5">
  {signers.length > 0 && (
    <div class="grid gap-4 sm:grid-cols-3">
      {signers.map((s) => (
        <div class="rounded-xl2 border border-brand-line bg-brand-surface p-4 shadow-card">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-muted">{s.role}</p>
          <p class="mt-1.5 text-sm font-semibold text-brand-fg">{s.name}</p>
          {s.date && <p class="mt-0.5 text-xs text-brand-muted">Data: {s.date}</p>}
        </div>
      ))}
    </div>
  )}

  {versions.length > 0 && (
    <div class="overflow-x-auto rounded-xl2 border border-brand-line shadow-card">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <thead>
          <tr class="bg-white/5">
            <th class="border-b border-brand-line px-4 py-3 font-semibold text-brand-fg-2">Versão</th>
            <th class="border-b border-brand-line px-4 py-3 font-semibold text-brand-fg-2">Data</th>
            <th class="border-b border-brand-line px-4 py-3 font-semibold text-brand-fg-2">Autor</th>
            <th class="border-b border-brand-line px-4 py-3 font-semibold text-brand-fg-2">Descrição da alteração</th>
          </tr>
        </thead>
        <tbody>
          {versions.map((v) => (
            <tr class="border-b border-brand-line last:border-0 even:bg-brand-surface/[0.03] hover:bg-brand-orange/5">
              <td class="whitespace-nowrap px-4 py-3 align-top font-medium text-brand-fg">{v.version}</td>
              <td class="whitespace-nowrap px-4 py-3 align-top text-brand-fg-2">{v.date}</td>
              <td class="px-4 py-3 align-top text-brand-fg-2">{v.author}</td>
              <td class="px-4 py-3 align-top text-brand-fg-2">{v.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>
