---
// Alerta/callout para observações, avisos e cuidados dentro do conteúdo do manual.
import Icon from './Icon.astro';

interface Props {
  type?: 'info' | 'atencao' | 'cuidado' | 'dica';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  info: { icon: 'info' as const, label: title ?? 'Observação', classes: 'border-brand-line bg-white/5', iconClasses: 'text-brand-muted' },
  dica: { icon: 'check-circle' as const, label: title ?? 'Dica', classes: 'border-brand-orange/30 bg-brand-orange/10', iconClasses: 'text-brand-orange' },
  atencao: { icon: 'alert-triangle' as const, label: title ?? 'Atenção', classes: 'border-amber-500/30 bg-amber-500/10', iconClasses: 'text-amber-400' },
  cuidado: { icon: 'alert-triangle' as const, label: title ?? 'Cuidado', classes: 'border-brand-red-on-dark/30 bg-brand-red-on-dark/10', iconClasses: 'text-brand-red-on-dark' },
};

const { icon, label, classes, iconClasses } = config[type];
---

<div class:list={['not-prose my-5 flex gap-3 rounded-lg border px-4 py-3.5 text-brand-fg-2', classes]}>
  <Icon name={icon} class:list={['mt-0.5 h-5 w-5 flex-shrink-0', iconClasses]} />
  <div class="text-sm leading-6">
    <p class="mb-1 font-semibold text-brand-fg">{label}</p>
    <div class="[&>p]:mb-0 [&>p:not(:last-child)]:mb-2">
      <slot />
    </div>
  </div>
</div>
