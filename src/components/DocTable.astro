---
// Tabela padrão do manual (Campos principais, Permissões, Problemas comuns, etc.)
interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div class="not-prose my-5 overflow-x-auto rounded-xl2 border border-brand-line shadow-card">
  <table class="w-full min-w-[480px] border-collapse text-left text-sm">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr class="bg-white/5">
        {headers.map((h) => (
          <th class="border-b border-brand-line px-4 py-3 font-semibold text-brand-fg-2">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-brand-line last:border-0 even:bg-brand-surface/[0.03] hover:bg-brand-orange/5">
          {row.map((cell, i) => (
            <td class:list={['px-4 py-3 align-top text-brand-fg-2', i === 0 && 'font-medium text-brand-fg whitespace-nowrap']}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
