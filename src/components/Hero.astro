---
import Badge from './Badge.astro';

interface InfoBadge {
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  badges?: InfoBadge[];
}

const { eyebrow, title, description, badges = [] } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<header class="relative overflow-hidden bg-hero-gradient">
  <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image: radial-gradient(circle at 85% 20%, rgba(241,136,0,0.25), transparent 45%);"></div>
  <div class="relative w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8 xl:px-10">
    <div class="mb-4">
      <slot name="breadcrumb" />
    </div>

    <div class:list={['lg:flex lg:gap-12', hasMedia && 'lg:items-center']}>
      <div class:list={[hasMedia && 'lg:flex-1']}>
        {eyebrow && (
          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-brand-orange">{eyebrow}</p>
        )}

        <h1 class="max-w-3xl text-2xl font-bold text-white sm:text-3xl">{title}</h1>

        {description && (
          <p class="mt-3 max-w-2xl text-sm leading-6 text-white/70 sm:text-base">{description}</p>
        )}

        {badges.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {badges.map((b) => (
              <Badge tone="neutral">
                <span class="text-white/50">{b.label}:</span>
                <span class="font-semibold text-white">{b.value}</span>
              </Badge>
            ))}
          </div>
        )}

        <slot />
      </div>

      {hasMedia && (
        <div class="mt-10 lg:mt-0 lg:w-[45%] lg:max-w-xl lg:flex-shrink-0">
          <slot name="media" />
        </div>
      )}
    </div>
  </div>
</header>
