---
// Simulador guiado genérico. Tela "burra": desenha o spec de src/lib/simuladores/<slug>.mjs
// pelo motor src/lib/simulador.mjs. Dentinho narra; cada passo mostra Permissão + Parâmetro.
// Regras ricas do .NET (quando existirem p/ a tela) vêm de _regras.json, embutidas só desta tela.
import regrasData from '../lib/simuladores/_regras.json';
interface Props { slug: string; lang?: 'pt' | 'en' }
const { slug, lang = 'pt' } = Astro.props;
const regrasTela = (regrasData as Record<string, any[]>)[slug] ?? [];
---

<section data-sim data-slug={slug} data-lang={lang} data-regras={JSON.stringify(regrasTela)} class="not-prose mx-auto w-full max-w-5xl flex-1">
  <noscript>
    <p class="rounded-xl2 border border-brand-line bg-brand-surface p-4 text-sm text-brand-fg-2">
      {lang === 'en' ? 'This guided training needs JavaScript enabled.' : 'Este treino guiado precisa de JavaScript ativado.'}
    </p>
  </noscript>

  <header class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-red-on-dark">{lang === 'en' ? 'Guided training' : 'Treino guiado'}</p>
    <h1 data-ui="titulo" class="mt-2 text-2xl font-bold text-brand-fg sm:text-3xl"></h1>
    <p data-ui="sub" class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-fg-2"></p>
    <div data-tipos-wrap class="mt-4 flex flex-wrap items-center gap-2">
      <span data-ui="tiposLabel" class="mr-1 text-xs font-semibold uppercase tracking-wide text-brand-muted"></span>
      <div data-tipos class="inline-flex flex-wrap rounded-lg border border-brand-line bg-brand-surface p-0.5"></div>
    </div>
    <div class="mt-3">
      <button data-modo-toggle type="button" class="rounded-lg border border-brand-line px-3 py-1.5 text-xs font-medium text-brand-fg-2 transition hover:bg-white/5"></button>
    </div>
  </header>

  <ol data-trilha class="tr-trilha"></ol>

  <div class="mt-5 grid gap-5 lg:grid-cols-5">
    <div class="lg:col-span-3 rounded-xl2 border border-brand-line bg-brand-surface p-5 shadow-card sm:p-6">
      <p data-cena="passo" class="text-xs font-semibold uppercase tracking-wide text-brand-muted"></p>

      <div class="mt-3 flex items-start gap-3">
        <span data-dentinho class="tr-dentinho flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-red"></span>
        <div class="relative flex-1 rounded-xl2 rounded-tl-sm border border-brand-line bg-brand-bg px-4 py-3 text-sm leading-relaxed text-brand-fg">
          <span data-cena="fala"></span>
        </div>
      </div>

      <h2 data-cena="titulo" class="mt-5 text-lg font-semibold text-brand-fg"></h2>
      <div class="mt-2 flex flex-wrap gap-2 text-xs" data-cena="tags"></div>

      <p data-cena="txt" class="mt-3 text-sm leading-relaxed text-brand-fg-2"></p>
      <p data-cena="pratica" class="mt-3 rounded-lg bg-white/5 px-3 py-2 text-sm text-brand-fg-2"></p>

      <!-- ficha: permissão + parâmetro deste passo -->
      <div data-cena="ficha" class="mt-3 space-y-2"></div>

      <!-- Dentinho ATIVO: perguntas contextuais desta etapa -->
      <div data-cena="dentinho-acoes" class="mt-3 flex flex-wrap gap-2"></div>

      <div data-cena="resultado" class="mt-3 hidden rounded-lg px-3 py-2 text-sm"></div>

      <!-- Modo Desafio: escolhas e placar -->
      <div data-desafio class="mt-4 hidden"></div>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <button data-act="principal" type="button" class="rounded-lg bg-brand-red px-4 py-2 text-sm font-semibold text-white shadow-card transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"></button>
        <button data-act="voltar" type="button" class="rounded-lg border border-brand-line px-3 py-2 text-sm text-brand-fg-2 transition hover:bg-white/5 disabled:opacity-30"></button>
        <button data-act="reiniciar" type="button" class="rounded-lg border border-brand-line px-3 py-2 text-sm text-brand-fg-2 transition hover:bg-white/5"></button>
      </div>

      <div data-cena="ese" class="mt-5 hidden">
        <p data-ui="ese" class="mb-2 text-xs font-semibold uppercase tracking-wide text-brand-muted"></p>
        <div data-ese-botoes class="flex flex-wrap gap-2"></div>
      </div>
    </div>

    <aside class="lg:col-span-2 rounded-xl2 border border-brand-line bg-brand-surface p-5 shadow-card sm:p-6">
      <h3 data-ui="painel" class="mb-4 text-sm font-semibold uppercase tracking-wide text-brand-muted"></h3>
      <div data-estado class="mb-4 space-y-2"></div>
      <dl data-painel class="space-y-3 text-sm"></dl>
    </aside>
  </div>

  <div class="mt-6 space-y-2">
    <details data-regras-wrap class="tr-det" hidden><summary data-ui="regrasSistema"></summary><ul data-regras-sistema class="mt-2 space-y-1.5 text-sm text-brand-fg-2"></ul></details>
    <details class="tr-det"><summary data-ui="regras"></summary><ul data-regras class="mt-2 list-disc space-y-1 pl-5 text-sm text-brand-fg-2"></ul></details>
    <details class="tr-det"><summary data-ui="quemFaz"></summary><ul data-quem class="mt-2 list-disc space-y-1 pl-5 text-sm text-brand-fg-2"></ul></details>
    <details class="tr-det"><summary data-ui="hist"></summary><ol data-hist class="mt-2 space-y-1 text-sm text-brand-fg-2"></ol></details>
  </div>
</section>

<style>
  .tr-trilha { display: flex; gap: 0; overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; list-style: none; padding-left: 0; margin: 0; }
  .tr-trilha li { position: relative; flex: 1 1 0; min-width: 92px; text-align: center; }
  .tr-trilha li::before { content: ''; position: absolute; top: 18px; left: -50%; width: 100%; height: 2px; background: #2a313c; }
  .tr-trilha li:first-child::before { display: none; }
  .tr-dot { position: relative; z-index: 1; display: inline-flex; height: 38px; width: 38px; align-items: center; justify-content: center; border-radius: 9999px; border: 2px solid #2a313c; background: #161b22; font-size: 16px; cursor: default; }
  .tr-dot.done { border-color: #1f9d63; background: rgba(31, 157, 99, 0.15); cursor: pointer; }
  .tr-dot.cur { border-color: #cc093b; box-shadow: 0 0 0 4px rgba(204, 9, 59, 0.18); }
  .tr-step-lbl { margin-top: 6px; display: block; font-size: 11px; color: #7d8590; }
  .tr-dot.cur + .tr-step-lbl { color: #ff5c86; font-weight: 600; }
  .tr-dentinho { animation: tr-pop 0.5s ease; }
  @keyframes tr-pop { 0% { transform: scale(0.5) rotate(-12deg); } 55% { transform: scale(1.12) rotate(6deg); } 100% { transform: scale(1) rotate(0deg); } }
  .tr-det { border: 1px solid #2a313c; border-radius: 0.75rem; background: #161b22; padding: 0.55rem 0.9rem; }
  .tr-det > summary { cursor: pointer; font-size: 0.875rem; font-weight: 600; color: #aeb6c2; list-style: none; }
  .tr-det > summary::-webkit-details-marker { display: none; }
  .tr-ficha { display: flex; gap: 0.5rem; align-items: flex-start; border-radius: 0.5rem; padding: 0.45rem 0.7rem; font-size: 0.8rem; line-height: 1.35; }
  .tr-ficha-perm { background: rgba(204, 9, 59, 0.08); border: 1px solid rgba(204, 9, 59, 0.25); }
  .tr-ficha-param { background: rgba(241, 136, 0, 0.08); border: 1px solid rgba(241, 136, 0, 0.3); }
  .tr-dente-btn { display:inline-flex; align-items:center; gap:.3rem; border-radius:9999px;
    border:1px solid rgba(204,9,59,0.3); background:rgba(204,9,59,0.07); color:#ff8aa6;
    padding:.3rem .7rem; font-size:.78rem; font-weight:500; cursor:pointer; transition:background .15s; }
  .tr-dente-btn:hover { background:rgba(204,9,59,0.15); }
  @media (prefers-reduced-motion: reduce) { .tr-dentinho { animation: none; } }
</style>

<script>
  import { UI, estadoInicial, executar, proximaAcao, faltando, envioBloqueado, mensagem, etapaAtual, pegadinhaDe, ordemDe } from '../lib/simulador.mjs';
  import { getSpec } from '../lib/simuladores/index.mjs';

  // Expressões do Dentinho: muda a boca (e, na dúvida, os olhos) conforme o contexto.
  const BOCA = {
    feliz: '<path d="M8.7 10.9c.9 1.5 5.7 1.5 6.6 0" stroke="#c81e2c" stroke-width="1.4" fill="none" stroke-linecap="round"/>',
    comemora: '<path d="M8.3 10.6c.95 2.4 5.85 2.4 6.8 0z" fill="#c81e2c"/><path d="M9.3 11.5c.7.7 3.9.7 4.6 0" stroke="#fff" stroke-width=".7" fill="none" stroke-linecap="round"/>',
    duvida: '<path d="M9 11.6c.7-.7 1.5-.7 2.1 0 .6.7 1.4.7 2.1 0" stroke="#c81e2c" stroke-width="1.3" fill="none" stroke-linecap="round"/>',
  };
  const dente = (expr = 'feliz') => `<svg viewBox="0 0 24 24" class="h-8 w-8" aria-hidden="true">
    <path fill="#fff" d="M12 2.2c-2.4 0-3.7 1.1-5.1 1.1-1.3 0-2.2-.7-3-.2-1 .7-1.1 2.4-1 4.2.1 1.7.5 3 1 4.8.4 1.5.6 3.1 1 4.9.3 1.4.6 3 1.6 3.6.9.6 1.6-.3 1.9-1.6.3-1.3.4-2.9 1.1-2.9s.8 1.6 1.1 2.9c.3 1.3 1 2.2 1.9 1.6 1-.6 1.3-2.2 1.6-3.6.4-1.8.6-3.4 1-4.9.5-1.8.9-3.1 1-4.8.1-1.8 0-3.5-1-4.2-.8-.5-1.7.2-3 .2-1.4 0-2.7-1.1-5.1-1.1z"/>
    <circle cx="7.7" cy="10.4" r="1.1" fill="#ffb3b3"/><circle cx="16.3" cy="10.4" r="1.1" fill="#ffb3b3"/>
    <circle cx="9.4" cy="8.4" r="${expr === 'duvida' ? '0.7' : '1.05'}" fill="#c81e2c"/><circle cx="14.6" cy="8.4" r="1.05" fill="#c81e2c"/>
    <circle cx="9.0" cy="8.0" r="0.32" fill="#fff"/><circle cx="14.2" cy="8.0" r="0.32" fill="#fff"/>
    ${expr === 'duvida' ? '<path d="M13.4 6.6c.6-.4 1.4-.4 2 0" stroke="#c81e2c" stroke-width=".8" fill="none" stroke-linecap="round"/>' : ''}
    ${BOCA[expr] || BOCA.feliz}
  </svg>`;
  const DENTE = dente('feliz');

  document.querySelectorAll('[data-sim]').forEach((root) => {
    const lang = root.getAttribute('data-lang') === 'en' ? 'en' : 'pt';
    const slug = root.getAttribute('data-slug');
    const spec = getSpec(slug);
    if (!spec) return;
    const ui = UI[lang];
    const m = spec.textos[lang];
    const $ = (s) => root.querySelector(s);

    const temEnviar = Object.values(spec.etapaTipo).includes('ENVIAR');

    let cenario = {};
    let hist = [estadoInicial(spec, cenario)];
    let acoes = [];
    let ultima = null;
    const atual = () => hist[hist.length - 1];

    // Modo Desafio: usuário escolhe a ação certa sem a ajuda do Dentinho; pontua no fim.
    let modo = 'guia';
    let placar = { acertos: 0, erros: 0 };
    const embaralhar = (a) => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const decoys = (certo, n) => embaralhar([...new Set(Object.values(m.etapas).map((e) => e.acao).filter((a) => a && a !== certo))]).slice(0, n);

    // textos fixos
    $('[data-ui="titulo"]').textContent = m.titulo;
    $('[data-ui="sub"]').textContent = m.sub;
    $('[data-ui="tiposLabel"]').textContent = ui.tiposLabel;
    $('[data-ui="ese"]').textContent = ui.ese;
    $('[data-ui="painel"]').textContent = ui.painel;
    $('[data-ui="regras"]').textContent = ui.regras;
    $('[data-ui="quemFaz"]').textContent = ui.quemFaz;
    $('[data-ui="hist"]').textContent = ui.hist;
    $('[data-regras]').innerHTML = (m.regras || []).map((r) => `<li>${r}</li>`).join('');
    $('[data-quem]').innerHTML = (m.quem || []).map((r) => `<li>${r}</li>`).join('');

    // Painel de REGRAS DO SISTEMA (mineradas do .NET, via _regras.json) — só se houver.
    let regrasTela = [];
    try { regrasTela = JSON.parse(root.dataset.regras || '[]'); } catch {}
    function fmtRegra(r) {
      const p = [];
      if (r.obrigatorio) p.push(lang === 'en' ? 'required' : 'obrigatório');
      if (r.maxLength != null) p.push(lang === 'en' ? `up to ${r.maxLength} chars` : `até ${r.maxLength} caracteres`);
      if (Array.isArray(r.faixa)) p.push(lang === 'en' ? `between ${r.faixa[0]} and ${r.faixa[1]}` : `entre ${r.faixa[0]} e ${r.faixa[1]}`);
      else {
        if (r.min != null) p.push((r.minInclusivo ? '≥ ' : '> ') + r.min);
        if (r.max != null) p.push('≤ ' + r.max);
      }
      return p.join(' · ');
    }
    if (regrasTela.length) {
      const comDesc = regrasTela.map((r) => ({ r, d: fmtRegra(r) })).filter((x) => x.d);
      if (comDesc.length) {
        $('[data-regras-wrap]').hidden = false;
        $('[data-ui="regrasSistema"]').textContent =
          (lang === 'en' ? '📏 System rules (from the code) · ' : '📏 Regras do sistema (do código) · ') + comDesc.length;
        $('[data-regras-sistema]').innerHTML = comDesc
          .map(({ r, d }) => {
            const campo = (r.campo && typeof r.campo === 'object') ? (r.campo[lang] || r.campo.pt) : r.campo;
            return `<li title="${(r.origem || '') + (r.msgKey ? ' · ' + r.msgKey : '')}"><strong class="text-brand-fg">${campo}</strong> — ${d}</li>`;
          })
          .join('');
      }
    }

    // seletor de variação (se houver)
    if (spec.variantes) {
      $('[data-tipos]').innerHTML = spec.variantes
        .map((v) => `<button type="button" data-tipo="${v.key}" class="rounded-md px-3 py-1.5 text-sm font-medium transition">${v.label[lang]}</button>`)
        .join('');
    } else {
      $('[data-tipos-wrap]').style.display = 'none';
    }

    function trocarTipo(t) { cenario = { variante: t }; hist = [estadoInicial(spec, cenario)]; acoes = []; ultima = null; placar = { acertos: 0, erros: 0 }; render(); }

    function aplicar(tipo) {
      const antes = atual();
      const r = executar(spec, antes, tipo);
      ultima = mensagem(spec, lang, r.outcome, r.estado);
      if (r.estado !== antes) hist.push(r.estado);
      acoes.push({ texto: ultima.texto, ok: ultima.ok });
      render(true);
    }

    function tentarSalvarSem() {
      const cheio = executar(spec, atual(), 'PREENCHER').estado;
      const semCampo = executar(spec, cheio, 'tirarPegadinha').estado;
      const r = executar(spec, semCampo, 'SALVAR');
      ultima = mensagem(spec, lang, r.outcome, r.estado);
      acoes.push({ texto: ultima.texto, ok: false });
      render(true);
    }

    function tentar(tipo) {
      const r = executar(spec, atual(), tipo);
      ultima = mensagem(spec, lang, r.outcome, r.estado);
      acoes.push({ texto: ultima.texto, ok: ultima.ok });
      render(true);
    }

    function render(pop = false) {
      const s = atual();
      const ordem = ordemDe(spec, s.variante);
      const trilhaIds = ordem.filter((id) => spec.etapaTipo[id] !== 'FIM');
      const etId = etapaAtual(spec, s);
      const et = m.etapas[etId];
      const idxTrilha = trilhaIds.indexOf(etId);
      const terminal = spec.etapaTipo[etId] === 'FIM';
      const passoN = terminal ? trilhaIds.length : idxTrilha + 1;

      // variação ativa
      root.querySelectorAll('[data-tipo]').forEach((b) => {
        const on = b.getAttribute('data-tipo') === s.variante;
        b.style.background = on ? '#cc093b' : 'transparent';
        b.style.color = on ? '#fff' : '#aeb6c2';
      });

      // trilha
      $('[data-trilha]').innerHTML = trilhaIds.map((id, i) => {
        const done = i < idxTrilha || terminal;
        const cur = id === etId;
        const cls = 'tr-dot' + (done ? ' done' : '') + (cur ? ' cur' : '');
        return `<li><span class="${cls}" data-goto="${done ? id : ''}">${m.etapas[id].ic}</span><span class="tr-step-lbl">${(m.trilha && m.trilha[id]) || m.etapas[id].tit}</span></li>`;
      }).join('');

      $('[data-cena="passo"]').textContent = ui.passo(passoN, trilhaIds.length);
      const expr = terminal ? 'comemora' : (ultima && ultima.ok === false ? 'duvida' : 'feliz');
      $('[data-dentinho]').innerHTML = dente(expr);
      if (pop) { const d = $('[data-dentinho]'); d.classList.remove('tr-dentinho'); void d.offsetWidth; d.classList.add('tr-dentinho'); }
      $('[data-cena="fala"]').textContent = et.fala;
      $('[data-cena="titulo"]').textContent = `${et.ic} ${et.tit}`;
      $('[data-cena="tags"]').innerHTML =
        `<span class="rounded-full bg-white/5 px-2 py-0.5 text-brand-fg-2">${ui.quem}: ${et.quem}</span>` +
        `<a class="rounded-full bg-white/5 px-2 py-0.5 text-brand-red-on-dark hover:underline" href="${et.href}">${ui.tela}: ${et.tela} →</a>`;
      $('[data-cena="txt"]').textContent = et.txt;
      $('[data-cena="pratica"]').textContent = '💡 ' + et.pratica;

      // ficha: permissão + parâmetro
      let ficha = '';
      if (et.permissao) ficha += `<div class="tr-ficha tr-ficha-perm"><span>🔑</span><span><strong class="text-brand-fg">${ui.permissao}:</strong> ${et.permissao}</span></div>`;
      if (et.parametro) ficha += `<div class="tr-ficha tr-ficha-param"><span>⚙️</span><span><strong class="text-brand-fg">${ui.parametro}:</strong> <code class="text-brand-orange">${et.parametro.chave}</code> — ${et.parametro.efeito}</span></div>`;
      $('[data-cena="ficha"]').innerHTML = ficha;

      // Dentinho ATIVO: publica o contexto da etapa e monta perguntas contextuais.
      const telaStep = et.tela || m.titulo;
      window.__simCtx = {
        slug, href: et.href, tela: telaStep, etapa: et.tit, variante: s.variante,
        objetivo: m.sub, regra: et.permissao || '', parametro: (et.parametro && et.parametro.chave) || '',
        passo: passoN, total: trilhaIds.length, lang,
      };
      const perguntas = lang === 'en'
        ? [
            { lbl: '🦷 Explain this step', q: `Explain the step "${et.tit}" of the ${telaStep} screen: what to do and why.` },
            { lbl: 'Why do I need this?', q: `Why is the step "${et.tit}" needed on the ${telaStep} screen, and what happens if I skip it?` },
            { lbl: 'What can go wrong?', q: `What can go wrong in the step "${et.tit}" of the ${telaStep} screen and how does the system respond?` },
          ]
        : [
            { lbl: '🦷 Explicar esta etapa', q: `Explique a etapa "${et.tit}" da tela ${telaStep}: o que fazer e por quê.` },
            { lbl: 'Por que preciso disso?', q: `Por que a etapa "${et.tit}" é necessária na tela ${telaStep} e o que acontece se eu não fizer?` },
            { lbl: 'E se eu errar?', q: `O que pode dar errado na etapa "${et.tit}" da tela ${telaStep} e como o sistema responde?` },
          ];
      $('[data-cena="dentinho-acoes"]').innerHTML = perguntas
        .map((p) => `<button type="button" data-pergunta="${encodeURIComponent(p.q)}" class="tr-dente-btn">${p.lbl}</button>`)
        .join('');

      // resultado
      const box = $('[data-cena="resultado"]');
      if (ultima && ultima.texto) {
        box.classList.remove('hidden');
        box.textContent = (ultima.ok ? '✓ ' : '⚠ ') + ultima.texto;
        box.style.background = ultima.ok ? 'rgba(31,157,99,0.12)' : 'rgba(204,9,59,0.12)';
        box.style.color = ultima.ok ? '#6ee7a8' : '#ff8aa6';
      } else box.classList.add('hidden');

      // botões
      const prox = proximaAcao(spec, s);
      const btn = $('[data-act="principal"]');
      if (prox) {
        btn.classList.remove('hidden');
        btn.textContent = et.acao || (prox === 'PREENCHER' ? (lang === 'en' ? 'Fill fields' : 'Preencher') : '→');
        btn.disabled = prox === 'ENVIAR' && envioBloqueado(spec, s);
      } else btn.classList.add('hidden');
      $('[data-act="voltar"]').textContent = ui.voltar;
      $('[data-act="voltar"]').disabled = hist.length <= 1;
      $('[data-act="reiniciar"]').textContent = ui.reiniciar;

      // Modo Desafio: rótulo do toggle, escolhas da etapa e placar final.
      $('[data-modo-toggle]').textContent = modo === 'desafio'
        ? (lang === 'en' ? '🎓 Guided mode' : '🎓 Modo Guiado')
        : (lang === 'en' ? '🎯 Challenge mode' : '🎯 Modo Desafio');
      const emDesafio = modo === 'desafio';
      const balao = $('[data-cena="fala"]').closest('.mt-3');
      if (balao) balao.style.display = emDesafio ? 'none' : '';
      $('[data-cena="pratica"]').style.display = emDesafio ? 'none' : '';
      $('[data-cena="dentinho-acoes"]').style.display = emDesafio ? 'none' : '';
      $('[data-cena="ese"]').style.display = emDesafio ? 'none' : '';
      const desafioWrap = $('[data-desafio]');
      if (emDesafio && !terminal && prox) {
        btn.classList.add('hidden');
        const certo = et.acao || '—';
        const opc = embaralhar([certo, ...decoys(certo, 2)]);
        desafioWrap.classList.remove('hidden');
        desafioWrap.innerHTML =
          `<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-brand-muted">${lang === 'en' ? 'Which action is correct?' : 'Qual é a ação correta?'}</p>` +
          `<div class="flex flex-col gap-2">` +
          opc.map((o) => `<button type="button" data-escolha="${o === certo}" class="rounded-lg border border-brand-line px-3 py-2 text-left text-sm text-brand-fg transition hover:bg-white/5">${o}</button>`).join('') +
          `</div>`;
      } else if (emDesafio && terminal) {
        const tot = placar.acertos + placar.erros;
        const nota = tot ? Math.round((placar.acertos / tot) * 100) : 100;
        desafioWrap.classList.remove('hidden');
        desafioWrap.innerHTML =
          `<div class="rounded-xl2 border border-brand-line bg-brand-bg p-4 text-center">` +
          `<p class="text-sm text-brand-fg-2">${lang === 'en' ? 'Your score' : 'Seu placar'}</p>` +
          `<p class="mt-1 text-3xl font-bold ${nota >= 70 ? 'text-emerald-400' : 'text-brand-red-on-dark'}">${nota}%</p>` +
          `<p class="mt-1 text-xs text-brand-muted">${placar.acertos} ✓ · ${placar.erros} ✗</p></div>`;
      } else {
        desafioWrap.classList.add('hidden');
        desafioWrap.innerHTML = '';
      }

      // E se…?
      const ese = [];
      const tipoAtual = spec.etapaTipo[etId];
      if (tipoAtual === 'SALVAR' && pegadinhaDe(spec, s)) ese.push({ k: 'salvarSem', t: ui.eseSalvarSem(m.campos[pegadinhaDe(spec, s)]) });
      if (temEnviar && !s.salvo) ese.push({ k: 'enviarAgora', t: ui.eseEnviarAgora });
      if (spec.exigeAnexo && s.salvo && !s.anexado) ese.push({ k: 'enviarSemAnexo', t: ui.eseEnviarSemAnexo });
      const eseWrap = $('[data-cena="ese"]');
      if (ese.length) {
        eseWrap.classList.remove('hidden');
        $('[data-ese-botoes]').innerHTML = ese.map((e) => `<button type="button" data-ese="${e.k}" class="rounded-lg border border-dashed border-brand-line px-3 py-1.5 text-xs text-brand-fg-2 transition hover:bg-white/5">${e.t}</button>`).join('');
      } else eseWrap.classList.add('hidden');

      // estado didático: progresso + próxima ação + pendências (genérico, do motor)
      const feitas = terminal ? trilhaIds.length : idxTrilha;
      const pct = trilhaIds.length ? Math.round((feitas / trilhaIds.length) * 100) : 0;
      const proxAcao = proximaAcao(spec, s);
      const faltaCampos = spec.etapaTipo[etId] === 'SALVAR' ? faltando(spec, s).map((k) => m.campos[k] || k) : [];
      let estHtml =
        `<div><div class="mb-1 flex justify-between text-xs text-brand-muted"><span>${lang === 'en' ? 'Progress' : 'Progresso'}</span><span>${feitas}/${trilhaIds.length}</span></div>` +
        `<div class="h-1.5 overflow-hidden rounded bg-white/10"><div class="h-1.5 rounded bg-emerald-500 transition-all" style="width:${pct}%"></div></div></div>`;
      if (terminal) {
        estHtml += `<div class="rounded-lg bg-emerald-500/12 px-3 py-1.5 text-sm font-medium text-emerald-300">✓ ${lang === 'en' ? 'Completed' : 'Concluído'}</div>`;
      } else {
        const rotAcao = et.acao || (proxAcao === 'PREENCHER' ? (lang === 'en' ? 'Fill fields' : 'Preencher') : '—');
        estHtml += `<div class="rounded-lg bg-brand-red/10 px-3 py-1.5 text-sm text-brand-red-on-dark">→ ${lang === 'en' ? 'Next' : 'Próxima'}: ${rotAcao}</div>`;
      }
      if (faltaCampos.length) {
        estHtml += `<div class="rounded-lg bg-amber-500/12 px-3 py-1.5 text-xs text-amber-300">⏳ ${lang === 'en' ? 'Pending' : 'Pendente'}: ${faltaCampos.join(', ')}</div>`;
      }
      $('[data-estado]').innerHTML = estHtml;

      // painel
      const linha = (k, v) => `<div class="flex justify-between gap-3"><dt class="text-brand-muted">${k}</dt><dd class="text-right font-medium text-brand-fg">${v}</dd></div>`;
      $('[data-painel]').innerHTML = spec.painel(s, lang).map((r) => linha(r.k, r.v)).join('');

      // histórico
      const h = $('[data-hist]');
      h.innerHTML = acoes.length
        ? acoes.map((a, i) => `<li>${i + 1}. <span class="${a.ok ? 'text-emerald-400' : 'text-brand-red-on-dark'}">${a.ok ? '✓' : '⚠'}</span> ${a.texto}</li>`).join('')
        : `<li class="text-brand-muted">${ui.histVazio}</li>`;
    }

    root.addEventListener('click', (e) => {
      const el = e.target.closest('[data-tipo],[data-act],[data-ese],[data-goto],[data-pergunta],[data-modo-toggle],[data-escolha]');
      if (!el) return;
      if (el.dataset.pergunta) { window.dispatchEvent(new CustomEvent('dentinho:perguntar', { detail: { texto: decodeURIComponent(el.dataset.pergunta) } })); return; }
      if (el.hasAttribute('data-modo-toggle')) { modo = modo === 'guia' ? 'desafio' : 'guia'; placar = { acertos: 0, erros: 0 }; hist = [estadoInicial(spec, cenario)]; acoes = []; ultima = null; render(); return; }
      if (el.hasAttribute('data-escolha')) {
        if (el.dataset.escolha === 'true') { placar.acertos++; aplicar(proximaAcao(spec, atual())); }
        else { placar.erros++; ultima = { ok: false, texto: lang === 'en' ? 'Not this one — try again.' : 'Não é essa — tente de novo.' }; render(true); }
        return;
      }
      if (el.dataset.tipo) return trocarTipo(el.dataset.tipo);
      if (el.dataset.act === 'principal') return aplicar(proximaAcao(spec, atual()));
      if (el.dataset.act === 'voltar') { if (hist.length > 1) { hist.pop(); acoes.pop(); ultima = null; render(); } return; }
      if (el.dataset.act === 'reiniciar') return trocarTipo(atual().variante);
      if (el.dataset.ese === 'salvarSem') return tentarSalvarSem();
      if (el.dataset.ese === 'enviarAgora') return tentar('ENVIAR');
      if (el.dataset.ese === 'enviarSemAnexo') return tentar('ENVIAR');
      if (el.dataset.goto) { const at = hist.map((x) => etapaAtual(spec, x)).lastIndexOf(el.dataset.goto); if (at >= 0) { hist = hist.slice(0, at + 1); ultima = null; render(); } }
    });

    render();
  });
</script>
