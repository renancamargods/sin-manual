---
import Icon from './Icon.astro';

interface QuickCard {
  label: string;
  title: string;
  text: string;
}

interface Props {
  cards: QuickCard[];
}

const { cards } = Astro.props;

const iconFor: Record<string, 'book' | 'shield' | 'alert-triangle'> = {
  FINALIDADE: 'book',
  USO: 'shield',
  CUIDADO: 'alert-triangle',
};
---

<div class="not-prose my-6 grid gap-4 sm:grid-cols-3">
  {cards.map((card) => (
    <div class="card">
      <div class="mb-3 flex items-center gap-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-gradient text-white">
          <Icon name={iconFor[card.label.toUpperCase()] ?? 'info'} class="h-4 w-4" />
        </span>
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-muted">{card.label}</span>
      </div>
      <p class="mb-1 text-sm font-semibold text-brand-fg">{card.title}</p>
      <p class="text-sm leading-6 text-brand-fg-2">{card.text}</p>
    </div>
  ))}
</div>
