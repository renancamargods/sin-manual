---
interface Props {
  tone?: 'neutral' | 'red' | 'orange' | 'success' | 'outline';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones: Record<string, string> = {
  neutral: 'bg-white/10 text-white border-white/20',
  red: 'bg-brand-red-on-dark/15 text-brand-red-on-dark border-brand-red-on-dark/25',
  orange: 'bg-brand-orange/15 text-brand-orange border-brand-orange/30',
  success: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
  outline: 'bg-white/5 text-brand-fg-2 border-brand-line',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-medium leading-none',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
