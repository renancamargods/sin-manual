---
interface Props {
  tone?: 'neutral' | 'red' | 'orange' | 'success' | 'outline';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones: Record<string, string> = {
  neutral: 'bg-white/10 text-white border-white/20',
  red: 'bg-brand-red/15 text-brand-red border-brand-red/25',
  orange: 'bg-brand-orange/15 text-brand-orange-dark border-brand-orange/30',
  success: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  outline: 'bg-gray-50 text-gray-600 border-gray-200',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-medium leading-none',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
