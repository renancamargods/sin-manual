---
// Treino guiado da tela Cliente. Tela "burra": só desenha o estado que vem de
// ../lib/treinoCliente.mjs. Dentinho se apresenta a cada passo.
interface Props { lang?: 'pt' | 'en' }
const { lang = 'pt' } = Astro.props;
---

<section
  data-treino
  data-lang={lang}
  class="not-prose mx-auto w-full max-w-5xl flex-1"
>
  <noscript>
    <p class="rounded-xl2 border border-brand-line bg-brand-surface p-4 text-sm text-brand-fg-2">
      {lang === 'en'
        ? 'This guided training needs JavaScript enabled.'
        : 'Este treino guiado precisa de JavaScript ativado.'}
    </p>
  </noscript>

  <!-- cabeçalho + seletor de tipo -->
  <header class="mb-6">
    <p data-ui="eyebrow" class="text-xs font-semibold uppercase tracking-wider text-brand-red-on-dark"></p>
    <h1 data-ui="titulo" class="mt-2 text-2xl font-bold text-brand-fg sm:text-3xl"></h1>
    <p data-ui="sub" class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-fg-2"></p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span data-ui="tiposLabel" class="mr-1 text-xs font-semibold uppercase tracking-wide text-brand-muted"></span>
      <div data-tipos class="inline-flex rounded-lg border border-brand-line bg-brand-surface p-0.5"></div>
    </div>
  </header>

  <!-- trilha -->
  <ol data-trilha class="tr-trilha"></ol>

  <!-- cena + painel -->
  <div class="mt-5 grid gap-5 lg:grid-cols-5">
    <!-- cena -->
    <div class="lg:col-span-3 rounded-xl2 border border-brand-line bg-brand-surface p-5 shadow-card sm:p-6">
      <p data-cena="passo" class="text-xs font-semibold uppercase tracking-wide text-brand-muted"></p>

      <!-- Dentinho apresentando -->
      <div class="mt-3 flex items-start gap-3">
        <span data-dentinho class="tr-dentinho flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-red"></span>
        <div class="tr-balao relative flex-1 rounded-xl2 rounded-tl-sm border border-brand-line bg-brand-bg px-4 py-3 text-sm leading-relaxed text-brand-fg">
          <span data-cena="fala"></span>
        </div>
      </div>

      <!-- título da etapa + tags -->
      <h2 data-cena="titulo" class="mt-5 text-lg font-semibold text-brand-fg"></h2>
      <div class="mt-2 flex flex-wrap gap-2 text-xs" data-cena="tags"></div>

      <p data-cena="txt" class="mt-3 text-sm leading-relaxed text-brand-fg-2"></p>
      <p data-cena="pratica" class="mt-3 rounded-lg bg-white/5 px-3 py-2 text-sm text-brand-fg-2"></p>

      <!-- resultado do último passo -->
      <div data-cena="resultado" class="mt-3 hidden rounded-lg px-3 py-2 text-sm"></div>

      <!-- botões -->
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <button data-act="principal" type="button"
          class="rounded-lg bg-brand-red px-4 py-2 text-sm font-semibold text-white shadow-card transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"></button>
        <button data-act="voltar" type="button"
          class="rounded-lg border border-brand-line px-3 py-2 text-sm text-brand-fg-2 transition hover:bg-white/5 disabled:opacity-30"></button>
        <button data-act="reiniciar" type="button"
          class="rounded-lg border border-brand-line px-3 py-2 text-sm text-brand-fg-2 transition hover:bg-white/5"></button>
      </div>

      <!-- E se…? -->
      <div data-cena="ese" class="mt-5 hidden">
        <p data-ui="ese" class="mb-2 text-xs font-semibold uppercase tracking-wide text-brand-muted"></p>
        <div data-ese-botoes class="flex flex-wrap gap-2"></div>
      </div>
    </div>

    <!-- painel do cliente -->
    <aside class="lg:col-span-2 rounded-xl2 border border-brand-line bg-brand-surface p-5 shadow-card sm:p-6">
      <h3 data-ui="painel" class="mb-4 text-sm font-semibold uppercase tracking-wide text-brand-muted"></h3>
      <dl data-painel class="space-y-3 text-sm"></dl>
    </aside>
  </div>

  <!-- recolhidos -->
  <div class="mt-6 space-y-2">
    <details class="tr-det">
      <summary data-ui="regras"></summary>
      <ul data-regras class="mt-2 list-disc space-y-1 pl-5 text-sm text-brand-fg-2"></ul>
    </details>
    <details class="tr-det">
      <summary data-ui="quemFaz"></summary>
      <ul data-quem class="mt-2 list-disc space-y-1 pl-5 text-sm text-brand-fg-2"></ul>
    </details>
    <details class="tr-det">
      <summary data-ui="hist"></summary>
      <ol data-hist class="mt-2 space-y-1 text-sm text-brand-fg-2"></ol>
    </details>
  </div>
</section>

<style>
  .tr-trilha {
    display: flex;
    gap: 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 4px;
  }
  .tr-trilha li {
    position: relative;
    flex: 1 1 0;
    min-width: 92px;
    text-align: center;
  }
  .tr-trilha li::before {
    content: '';
    position: absolute;
    top: 18px;
    left: -50%;
    width: 100%;
    height: 2px;
    background: var(--tr-line, #2a313c);
  }
  .tr-trilha li:first-child::before { display: none; }
  .tr-dot {
    position: relative;
    z-index: 1;
    display: inline-flex;
    height: 38px;
    width: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 2px solid #2a313c;
    background: #161b22;
    font-size: 16px;
    cursor: default;
  }
  .tr-dot.done { border-color: #1f9d63; background: rgba(31, 157, 99, 0.15); cursor: pointer; }
  .tr-dot.cur { border-color: #cc093b; box-shadow: 0 0 0 4px rgba(204, 9, 59, 0.18); }
  .tr-step-lbl { margin-top: 6px; display: block; font-size: 11px; color: #7d8590; }
  .tr-dot.cur + .tr-step-lbl { color: #ff5c86; font-weight: 600; }

  /* Dentinho "pop" a cada passo */
  .tr-dentinho { animation: tr-pop 0.5s ease; }
  @keyframes tr-pop {
    0% { transform: scale(0.5) rotate(-12deg); }
    55% { transform: scale(1.12) rotate(6deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
  .tr-det {
    border: 1px solid #2a313c;
    border-radius: 0.75rem;
    background: #161b22;
    padding: 0.55rem 0.9rem;
  }
  .tr-det > summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: #aeb6c2;
    list-style: none;
  }
  .tr-det > summary::-webkit-details-marker { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .tr-dentinho { animation: none; }
  }
</style>

<script>
  import {
    estadoInicial, executar, proximaAcao, podeEnviar, faltando,
    mensagem, modelo, TRILHA, PEGADINHA,
  } from '../lib/treinoCliente.mjs';

  // carinha feliz do Dentinho (mesma do assistente), escalável
  const DENTE = `<svg viewBox="0 0 24 24" class="h-8 w-8" aria-hidden="true">
    <path fill="#fff" d="M12 2.2c-2.4 0-3.7 1.1-5.1 1.1-1.3 0-2.2-.7-3-.2-1 .7-1.1 2.4-1 4.2.1 1.7.5 3 1 4.8.4 1.5.6 3.1 1 4.9.3 1.4.6 3 1.6 3.6.9.6 1.6-.3 1.9-1.6.3-1.3.4-2.9 1.1-2.9s.8 1.6 1.1 2.9c.3 1.3 1 2.2 1.9 1.6 1-.6 1.3-2.2 1.6-3.6.4-1.8.6-3.4 1-4.9.5-1.8.9-3.1 1-4.8.1-1.8 0-3.5-1-4.2-.8-.5-1.7.2-3 .2-1.4 0-2.7-1.1-5.1-1.1z"/>
    <circle cx="7.7" cy="10.4" r="1.1" fill="#ffb3b3"/><circle cx="16.3" cy="10.4" r="1.1" fill="#ffb3b3"/>
    <circle cx="9.4" cy="8.4" r="1.05" fill="#c81e2c"/><circle cx="14.6" cy="8.4" r="1.05" fill="#c81e2c"/>
    <circle cx="9.0" cy="8.0" r="0.32" fill="#fff"/><circle cx="14.2" cy="8.0" r="0.32" fill="#fff"/>
    <path d="M8.7 10.9c.9 1.5 5.7 1.5 6.6 0" stroke="#c81e2c" stroke-width="1.4" fill="none" stroke-linecap="round"/>
  </svg>`;

  const UI = {
    pt: {
      eyebrow: 'Treino guiado', titulo: 'Cadastrar um Cliente, passo a passo',
      sub: 'Simulador de treino — nada é salvo no sistema. Siga o cliente do pré-cadastro até a ativação; cada recusa explica o porquê.',
      tiposLabel: 'Tipo de pessoa', passo: (i, n) => `Etapa ${i} de ${n}`,
      quem: 'Quem', tela: 'Tela', voltar: '← Voltar', reiniciar: '↺ Reiniciar', ese: 'E se…?',
      painel: 'Painel do cliente', status: 'Status', tipo: 'Tipo', doc: 'Documento', anexos: 'Anexos', sap: 'Código SAP',
      anexSim: '✓ anexados', anexNao: '⏳ pendentes', semSap: '— (só após aprovação)',
      regras: '📏 Regras desta tela', quemFaz: '👥 Quem pode cadastrar', hist: '📜 O que você fez',
      histVazio: 'Nada ainda — comece pelo botão da etapa.',
      eseSalvarSem: (c) => `Tentar salvar sem "${c}"`,
      eseEnviarAgora: 'Tentar "Enviar Cliente" agora',
      eseEnviarSemAnexo: 'Enviar sem anexar documentos',
      trilha: { PRE: 'Pré-cadastro', DADOS: 'Dados', SALVO: 'Salvar', ANEXADO: 'Anexos', ENVIADO: 'Enviar' },
      regrasList: [
        'Documento: PF e PJ obrigatório; Estrangeiro dispensa. PF usa CPF válido; PJ usa CNPJ válido.',
        'Obrigatórios mudam por tipo: PJ exige Inscrição Estadual; Estrangeiro exige Moeda e Lista de Preço (e dispensa e-mail/credencial).',
        'Antes do 1º Salvar aparecem só 4 abas; depois de salvar liberam as demais e o cabeçalho do cliente.',
        '"Enviar Cliente" só habilita depois de salvar — e os anexos obrigatórios são exigidos no envio.',
        'Alçada por tipo: PF → Crédito; PJ → Crédito + Fiscal; Estrangeiro → Crédito Internacional + Fiscal.',
        'Código SAP é gerado automaticamente só quando a alçada aprova (status ATIVO).',
      ],
      quemList: [
        'Usuário Master (Administrador): acesso total — cria clientes e acessa as configurações gerais.',
        'Usuário Comum (ex.: Consultor): cria clientes vinculados ao seu perfil.',
        'A decisão de aprovar/reprovar não é feita aqui — é na Fila de Aprovações de Cadastro.',
      ],
    },
    en: {
      eyebrow: 'Guided training', titulo: 'Register a Customer, step by step',
      sub: 'Training simulator — nothing is saved in the system. Follow the customer from pre-registration to activation; every refusal explains why.',
      tiposLabel: 'Person type', passo: (i, n) => `Step ${i} of ${n}`,
      quem: 'Who', tela: 'Screen', voltar: '← Back', reiniciar: '↺ Restart', ese: 'What if…?',
      painel: 'Customer panel', status: 'Status', tipo: 'Type', doc: 'Document', anexos: 'Attachments', sap: 'SAP code',
      anexSim: '✓ attached', anexNao: '⏳ pending', semSap: '— (only after approval)',
      regras: '📏 Rules of this screen', quemFaz: '👥 Who can register', hist: '📜 What you did',
      histVazio: 'Nothing yet — start with the step button.',
      eseSalvarSem: (c) => `Try to save without "${c}"`,
      eseEnviarAgora: 'Try "Submit Customer" now',
      eseEnviarSemAnexo: 'Submit without attaching documents',
      trilha: { PRE: 'Pre-reg.', DADOS: 'Data', SALVO: 'Save', ANEXADO: 'Attach', ENVIADO: 'Submit' },
      regrasList: [
        'Document: required for Individual and Company; Foreign is exempt. Individual uses a valid CPF; Company a valid CNPJ.',
        'Required fields change by type: Company needs State Registration; Foreign needs Currency and Price List (and skips e-mail/credential).',
        'Before the first Save only 4 tabs appear; after saving the others unlock along with the customer header.',
        '"Submit Customer" only enables after saving — and required attachments are enforced at submission.',
        'Approval level by type: Individual → Credit; Company → Credit + Tax; Foreign → International Credit + Tax.',
        'The SAP code is generated automatically only when the level approves (ACTIVE status).',
      ],
      quemList: [
        'Master user (Administrator): full access — creates customers and reaches general settings.',
        'Common user (e.g. Consultant): creates customers tied to their profile.',
        'The approve/reject decision is not made here — it happens in the Registration Approval Queue.',
      ],
    },
  };

  document.querySelectorAll('[data-treino]').forEach((root) => {
    const lang = root.getAttribute('data-lang') === 'en' ? 'en' : 'pt';
    const ui = UI[lang];
    const m = modelo(lang);
    const $ = (sel) => root.querySelector(sel);

    let cenario = { tipo: 'PF' };
    let hist = [estadoInicial(cenario)]; // pilha de estados (Voltar = pop)
    let acoes = []; // histórico legível
    let ultima = null; // { ok, texto } do último passo

    const atual = () => hist[hist.length - 1];

    // textos fixos
    $('[data-ui="eyebrow"]').textContent = ui.eyebrow;
    $('[data-ui="titulo"]').textContent = ui.titulo;
    $('[data-ui="sub"]').textContent = ui.sub;
    $('[data-ui="tiposLabel"]').textContent = ui.tiposLabel;
    $('[data-ui="ese"]').textContent = ui.ese;
    $('[data-ui="painel"]').textContent = ui.painel;
    $('[data-ui="regras"]').textContent = ui.regras;
    $('[data-ui="quemFaz"]').textContent = ui.quemFaz;
    $('[data-ui="hist"]').textContent = ui.hist;
    $('[data-regras]').innerHTML = ui.regrasList.map((r) => `<li>${r}</li>`).join('');
    $('[data-quem]').innerHTML = ui.quemList.map((r) => `<li>${r}</li>`).join('');

    // seletor de tipo
    const tipos = ['PF', 'PJ', 'EST'];
    $('[data-tipos]').innerHTML = tipos
      .map((t) => `<button type="button" data-tipo="${t}" class="rounded-md px-3 py-1.5 text-sm font-medium transition">${m.tipos[t]}</button>`)
      .join('');

    function trocarTipo(t) {
      cenario = { tipo: t };
      hist = [estadoInicial(cenario)];
      acoes = [];
      ultima = null;
      render();
    }

    function aplicar(acao, registra = true) {
      const antes = atual();
      const r = executar(antes, acao);
      ultima = mensagem(lang, r.outcome, r.estado);
      if (r.estado !== antes) {
        hist.push(r.estado);
        if (registra) acoes.push({ acao, texto: ultima.texto, ok: ultima.ok });
      } else if (registra) {
        acoes.push({ acao, texto: ultima.texto, ok: ultima.ok });
      }
      render(true);
    }

    // "E se…?": preenche tudo MENOS o campo-pegadinha e tenta salvar, pra isolar
    // a lição (só aquele obrigatório falta). Não avança — é só demonstração.
    function tentarSalvarSem() {
      const cheio = executar(atual(), 'preencher').estado;
      const semCampo = executar(cheio, 'tirarPegadinha').estado;
      const r = executar(semCampo, 'salvar');
      ultima = mensagem(lang, r.outcome, r.estado);
      acoes.push({ acao: 'tentativa', texto: ultima.texto, ok: false });
      render(true);
    }

    function tentar(acao) {
      const r = executar(atual(), acao);
      ultima = mensagem(lang, r.outcome, r.estado);
      acoes.push({ acao: 'tentativa', texto: ultima.texto, ok: ultima.ok });
      render(true);
    }

    function render(pop = false) {
      const s = atual();
      const et = m.etapas[s.etapa];
      const idx = TRILHA.indexOf(s.etapa);
      const passoN = s.etapa === 'ATIVO' ? TRILHA.length : idx + 1;

      // tipos ativos
      root.querySelectorAll('[data-tipo]').forEach((b) => {
        const on = b.getAttribute('data-tipo') === s.tipo;
        b.style.background = on ? '#cc093b' : 'transparent';
        b.style.color = on ? '#fff' : '#aeb6c2';
      });

      // trilha
      $('[data-trilha]').innerHTML = TRILHA.map((st, i) => {
        const done = i < idx || s.etapa === 'ATIVO';
        const cur = st === s.etapa;
        const cls = 'tr-dot' + (done ? ' done' : '') + (cur ? ' cur' : '');
        const ic = m.etapas[st].ic;
        return `<li><span class="${cls}" data-goto="${done ? st : ''}">${ic}</span><span class="tr-step-lbl">${ui.trilha[st]}</span></li>`;
      }).join('');

      // cena
      $('[data-cena="passo"]').textContent = ui.passo(passoN, TRILHA.length);
      $('[data-dentinho]').innerHTML = DENTE;
      if (pop) {
        const d = $('[data-dentinho]');
        d.classList.remove('tr-dentinho'); void d.offsetWidth; d.classList.add('tr-dentinho');
      }
      $('[data-cena="fala"]').textContent = et.fala;
      $('[data-cena="titulo"]').textContent = `${et.ic} ${et.tit}`;
      $('[data-cena="tags"]').innerHTML =
        `<span class="rounded-full bg-white/5 px-2 py-0.5 text-brand-fg-2">${ui.quem}: ${et.quem}</span>` +
        `<a class="rounded-full bg-white/5 px-2 py-0.5 text-brand-red-on-dark hover:underline" href="${et.href}">${ui.tela}: ${et.tela} →</a>`;
      $('[data-cena="txt"]').textContent = et.txt;
      $('[data-cena="pratica"]').textContent = '💡 ' + et.pratica;

      // resultado
      const box = $('[data-cena="resultado"]');
      if (ultima && ultima.texto) {
        box.classList.remove('hidden');
        box.textContent = (ultima.ok ? '✓ ' : '⚠ ') + ultima.texto;
        box.style.background = ultima.ok ? 'rgba(31,157,99,0.12)' : 'rgba(204,9,59,0.12)';
        box.style.color = ultima.ok ? '#6ee7a8' : '#ff8aa6';
      } else {
        box.classList.add('hidden');
      }

      // botões
      const prox = proximaAcao(s);
      const btn = $('[data-act="principal"]');
      if (prox) {
        btn.classList.remove('hidden');
        btn.textContent = m.etapas[s.etapa].acao;
        // "Enviar Cliente" desabilitado enquanto não pode enviar (regra visível)
        btn.disabled = prox === 'enviar' && !podeEnviar(s);
      } else {
        btn.classList.add('hidden');
      }
      $('[data-act="voltar"]').textContent = ui.voltar;
      $('[data-act="voltar"]').disabled = hist.length <= 1;
      $('[data-act="reiniciar"]').textContent = ui.reiniciar;

      // E se…?
      const ese = [];
      if (s.etapa === 'DADOS') ese.push({ k: 'salvarSem', t: ui.eseSalvarSem(m.campos[PEGADINHA[s.tipo]]) });
      if (s.etapa === 'PRE' || s.etapa === 'DADOS') ese.push({ k: 'enviarAgora', t: ui.eseEnviarAgora });
      if (s.etapa === 'SALVO') ese.push({ k: 'enviarSemAnexo', t: ui.eseEnviarSemAnexo });
      const eseWrap = $('[data-cena="ese"]');
      if (ese.length) {
        eseWrap.classList.remove('hidden');
        $('[data-ese-botoes]').innerHTML = ese
          .map((e) => `<button type="button" data-ese="${e.k}" class="rounded-lg border border-dashed border-brand-line px-3 py-1.5 text-xs text-brand-fg-2 transition hover:bg-white/5">${e.t}</button>`)
          .join('');
      } else {
        eseWrap.classList.add('hidden');
      }

      // painel
      const linha = (k, v) => `<div class="flex justify-between gap-3"><dt class="text-brand-muted">${k}</dt><dd class="text-right font-medium text-brand-fg">${v}</dd></div>`;
      $('[data-painel]').innerHTML =
        linha(ui.status, m.statusLabel[s.statusKey]) +
        linha(ui.tipo, m.tipos[s.tipo]) +
        linha(ui.doc, s.documento) +
        linha(ui.anexos, s.anexado ? ui.anexSim : ui.anexNao) +
        linha(ui.sap, s.codigoSap || ui.semSap);

      // histórico
      const h = $('[data-hist]');
      if (!acoes.length) {
        h.innerHTML = `<li class="text-brand-muted">${ui.histVazio}</li>`;
      } else {
        h.innerHTML = acoes
          .map((a, i) => `<li>${i + 1}. <span class="${a.ok ? 'text-emerald-400' : 'text-brand-red-on-dark'}">${a.ok ? '✓' : '⚠'}</span> ${a.texto}</li>`)
          .join('');
      }
    }

    // eventos (delegação)
    root.addEventListener('click', (e) => {
      const el = e.target.closest('[data-tipo],[data-act],[data-ese],[data-goto]');
      if (!el) return;
      if (el.dataset.tipo) return trocarTipo(el.dataset.tipo);
      if (el.dataset.act === 'principal') return aplicar(proximaAcao(atual()));
      if (el.dataset.act === 'voltar') { if (hist.length > 1) { hist.pop(); acoes.pop(); ultima = null; render(); } return; }
      if (el.dataset.act === 'reiniciar') return trocarTipo(cenario.tipo);
      if (el.dataset.ese === 'salvarSem') return tentarSalvarSem();
      if (el.dataset.ese === 'enviarAgora') return tentar('enviar');
      if (el.dataset.ese === 'enviarSemAnexo') return tentar('enviar');
      if (el.dataset.goto) { // rebobina para uma etapa já visitada
        const st = el.dataset.goto;
        const at = hist.map((x) => x.etapa).lastIndexOf(st);
        if (at >= 0) { hist = hist.slice(0, at + 1); ultima = null; render(); }
      }
    });

    render();
  });
</script>
