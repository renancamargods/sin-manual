{
  "name": "sin-manual",
  "compatibility_date": "2025-01-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // IA do manual ("Dentinho"): Workers AI roda modelos abertos dentro do Worker,
  // na cota grátis da Cloudflare. Sem chave externa, sem cartão.
  "ai": {
    "binding": "AI"
  }
}
